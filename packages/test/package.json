{
  "name": "@unworklet/test",
  "version": "0.0.0",
  "description": "Vitest matchers for `@unworklet/core` processors (wraps `@unworklet/offline`).",
  "keywords": [
    "audio",
    "audioworklet",
    "dsp",
    "matchers",
    "testing",
    "vitest"
  ],
  "homepage": "https://github.com/yuichkun/unworklet#readme",
  "bugs": "https://github.com/yuichkun/unworklet/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuichkun/unworklet.git",
    "directory": "packages/test"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./extend": {
      "types": "./src/extend.ts",
      "development": "./src/extend.ts",
      "import": "./dist/extend.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./extend": {
        "types": "./dist/extend.d.mts",
        "import": "./dist/extend.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@unworklet/offline": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "@unworklet/core": "workspace:*",
    "bumpp": "^11.1.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@unworklet/core": "workspace:*",
    "vitest": "^3 || ^4"
  }
}
