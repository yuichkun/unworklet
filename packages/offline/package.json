{
  "name": "@unworklet/offline",
  "version": "0.0.0",
  "description": "Pure-JS offline renderer for `@unworklet/core` processors (Node / Bun / Deno).",
  "keywords": [
    "audio",
    "dsp",
    "offline",
    "render",
    "testing",
    "wav",
    "webassembly"
  ],
  "homepage": "https://github.com/yuichkun/unworklet#readme",
  "bugs": "https://github.com/yuichkun/unworklet/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuichkun/unworklet.git",
    "directory": "packages/offline"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "wavefile": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "@unworklet/core": "workspace:*",
    "bumpp": "^11.1.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@unworklet/core": "workspace:*"
  }
}
