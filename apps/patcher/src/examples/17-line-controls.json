{
  "name": "17 — line~ smoothing + viz",
  "description": "slider→line~ smooths cutoff at audio-rate; saw→biquad-driven via line~; meter~/scope~/number~ on output. Drag the slider — no zipper noise.",
  "patch": {
    "nodes": [
      { "id": "src",    "type": "saw~",   "pos": { "x": 40,  "y": 40 }, "args": [120] },
      { "id": "cutoff", "type": "slider", "pos": { "x": 220, "y": 40 }, "attrs": { "min": 100, "max": 4000, "value": 800, "label": "cutoff (slider→line~)" } },
      { "id": "smooth", "type": "line~",  "pos": { "x": 220, "y": 140 }, "args": [50] },
      { "id": "filt",   "type": "lores~", "pos": { "x": 40,  "y": 240 } },
      { "id": "q",      "type": "dial",   "pos": { "x": 220, "y": 240 }, "attrs": { "min": 0.1, "max": 0.9, "value": 0.4, "label": "Q" } },

      { "id": "lvl",    "type": "*~",     "pos": { "x": 40,  "y": 360 }, "args": [0.3] },
      { "id": "scope",  "type": "scope~", "pos": { "x": 220, "y": 360 } },
      { "id": "meter",  "type": "meter~", "pos": { "x": 420, "y": 360 } },
      { "id": "num",    "type": "number~","pos": { "x": 580, "y": 360 } },
      { "id": "out",    "type": "dac~",   "pos": { "x": 40,  "y": 460 } },

      { "id": "lblLine", "type": "comment", "pos": { "x": 220, "y": 220 }, "attrs": { "text": "line~ ramp 50 ms" } }
    ],
    "cords": [
      { "src": { "node": "cutoff", "outlet": 0 }, "dst": { "node": "smooth", "inlet": 0 } },
      { "src": { "node": "smooth", "outlet": 0 }, "dst": { "node": "filt", "inlet": 1 } },

      { "src": { "node": "src",  "outlet": 0 }, "dst": { "node": "filt", "inlet": 0 } },
      { "src": { "node": "q",    "outlet": 0 }, "dst": { "node": "filt", "inlet": 2 } },

      { "src": { "node": "filt", "outlet": 0 }, "dst": { "node": "lvl", "inlet": 0 } },
      { "src": { "node": "lvl",  "outlet": 0 }, "dst": { "node": "scope", "inlet": 0 } },
      { "src": { "node": "scope","outlet": 0 }, "dst": { "node": "meter", "inlet": 0 } },
      { "src": { "node": "meter","outlet": 0 }, "dst": { "node": "num",   "inlet": 0 } },
      { "src": { "node": "num",  "outlet": 0 }, "dst": { "node": "out", "inlet": 0 } },
      { "src": { "node": "num",  "outlet": 0 }, "dst": { "node": "out", "inlet": 1 } }
    ]
  }
}
