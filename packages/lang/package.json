{
  "name": "@unworklet/lang",
  "version": "0.0.0",
  "description": "Build-time `.uwk.ts` → virtual `.ts` authoring frontend that lowers to `@unworklet/core`.",
  "license": "MIT",
  "bin": {
    "unworklet-tsc": "./dist/unworklet-tsc.mjs"
  },
  "files": [
    "dist",
    "typescript-plugin"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "import": "./dist/browser.mjs"
    },
    "./typescript-plugin": {
      "require": "./typescript-plugin/index.js",
      "default": "./typescript-plugin/index.js"
    },
    "./ambient": {
      "types": "./dist/ambient.d.ts"
    },
    "./ambient.d.ts": "./dist/ambient.d.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./browser": {
        "types": "./dist/browser.d.mts",
        "import": "./dist/browser.mjs"
      },
      "./typescript-plugin": {
        "require": "./typescript-plugin/index.js",
        "default": "./typescript-plugin/index.js"
      },
      "./ambient": {
        "types": "./dist/ambient.d.ts"
      },
      "./ambient.d.ts": "./dist/ambient.d.ts",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@volar/language-core": "catalog:",
    "@volar/typescript": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "@unworklet/core": "workspace:*",
    "@unworklet/offline": "workspace:*",
    "bumpp": "^11.1.0",
    "esbuild": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@unworklet/core": "workspace:*"
  }
}
