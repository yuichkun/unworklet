{
  "name": "@unworklet/core",
  "version": "0.0.0",
  "description": "Audio Worklet DSP authored in TypeScript, compiled to WebAssembly.",
  "keywords": [
    "audio",
    "audioworklet",
    "dsp",
    "midi",
    "realtime",
    "synthesis",
    "typescript",
    "wasm",
    "web-audio",
    "webassembly"
  ],
  "homepage": "https://github.com/yuichkun/unworklet#readme",
  "bugs": "https://github.com/yuichkun/unworklet/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuichkun/unworklet.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./simd": {
      "types": "./src/simd.ts",
      "development": "./src/simd.ts",
      "import": "./dist/simd.mjs"
    },
    "./worklet": {
      "types": "./src/worklet-entry.ts",
      "development": "./src/worklet-entry.ts",
      "import": "./dist/worklet-entry.mjs"
    },
    "./dev": {
      "types": "./src/dev.ts",
      "development": "./src/dev.ts",
      "import": "./dist/dev.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./simd": {
        "types": "./dist/simd.d.mts",
        "import": "./dist/simd.mjs"
      },
      "./worklet": {
        "types": "./dist/worklet-entry.d.mts",
        "import": "./dist/worklet-entry.mjs"
      },
      "./dev": {
        "types": "./dist/dev.d.mts",
        "import": "./dist/dev.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:browser": "vp pack && vp test --config vite.browser.config.ts",
    "test:browser:postmessage": "vp pack && vp test --config vite.browser-postmessage.config.ts",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "binaryen": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "@unworklet/unplugin": "workspace:^",
    "bumpp": "^11.1.0",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
