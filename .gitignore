# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
coverage
*.local
*.wav
!**/__snapshots__/*.wav

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI agent worktrees
.claude/worktrees/
.claude/scheduled_tasks.lock

# Playwright
test-results/
playwright-report/

# Vitest browser-mode run artifacts (failure screenshots / attachments)
**/.vitest-attachments/
**/__screenshots__/

# Vite+ git hooks (generated locally by `vp config` after clone)
.vite-hooks/

# Transient lowered-`.uwk.ts` temps the loader writes then removes (a killed build
# can strand them)
*.uwklowered.mjs
*.uwkfailed.mjs

# Generated editor TS-server plugin bundle (built by @unworklet/lang's build.mjs)
/packages/lang/typescript-plugin/

# Generated witness dir written by @unworklet/unplugin (project-local tsconfig + worklets.d.ts)
**/.unworklet/

# Vercel CLI project link (local, per-machine)
.vercel
