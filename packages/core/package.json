{
  "name": "@unworklet/core",
  "version": "0.0.0",
  "description": "Audio Worklet DSP authored in TypeScript, compiled to WebAssembly.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./simd": {
      "types": "./src/simd.ts",
      "development": "./src/simd.ts",
      "import": "./dist/simd.mjs"
    },
    "./worklet": {
      "types": "./src/worklet-entry.ts",
      "development": "./src/worklet-entry.ts",
      "import": "./dist/worklet-entry.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "binaryen": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "@unworklet/vite-plugin": "workspace:*",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "bumpp": "^11.1.0",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
