{
  "name": "@unworklet/unplugin",
  "version": "0.0.0",
  "description": "Vite plugin for `@unworklet/core` processors (`?worklet` imports, source maps, DevTools panels, analysis JSON).",
  "keywords": [
    "audio",
    "audioworklet",
    "dsp",
    "unplugin",
    "vite",
    "webassembly",
    "worklet"
  ],
  "homepage": "https://github.com/yuichkun/unworklet#readme",
  "bugs": "https://github.com/yuichkun/unworklet/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuichkun/unworklet.git",
    "directory": "packages/unplugin"
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./devbridge": {
      "types": "./src/devbridge.ts",
      "development": "./src/devbridge.ts",
      "import": "./dist/devbridge.mjs"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./devbridge": {
        "types": "./dist/devbridge.d.mts",
        "import": "./dist/devbridge.mjs"
      },
      "./client": {
        "types": "./client.d.ts"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "dev": "vp pack --watch src/index.ts src/devbridge.ts",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@unworklet/lang": "workspace:^",
    "unplugin": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "@vitejs/devtools-kit": "catalog:",
    "bumpp": "^11.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@unworklet/core": "workspace:^",
    "vite": "^6 || ^7 || ^8"
  },
  "engines": {
    "node": ">=20"
  }
}
