{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["@vitejs/devtools-kit", "node"]
  },
  "include": ["src/**/*", "vite.config.ts"],
  // `.uwk.ts` is sugar — a deliberate TS error until lowered (the plugin lowers
  // it); excluded from the standalone `tsc` program (each also carries
  // `// @ts-nocheck` for the type-aware lint). `.uwklowered.ts` is the transient
  // temp the build path writes while lowering.
  "exclude": ["**/*.uwk.ts", "**/*.uwklowered.ts"]
}
