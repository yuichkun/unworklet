{
  "name": "22 — MIDI CC + note + pitchbend",
  "description": "notein → mtof~ → cycle~. ctlin (CC#1) → scale~ → cutoff. pitchbend → ±2 semitone vibrato. Click 'enable MIDI' to drive from a real keyboard.",
  "patch": {
    "nodes": [
      { "id": "intro", "type": "comment", "pos": { "x": 40, "y": 20 }, "attrs": { "text": "MIDI demo — toggle 'enable MIDI' in the toolbar" } },

      { "id": "ni",    "type": "notein",   "pos": { "x": 40,  "y": 60 } },
      { "id": "cc",    "type": "ctlin",    "pos": { "x": 220, "y": 60 }, "attrs": { "controller": 1, "channel": 0 } },
      { "id": "pb",    "type": "pitchbend","pos": { "x": 400, "y": 60 } },
      { "id": "raw",   "type": "midiin",   "pos": { "x": 580, "y": 60 } },

      { "id": "mtof",  "type": "mtof~",    "pos": { "x": 40,  "y": 180 } },
      { "id": "pbsc",  "type": "scale~",   "pos": { "x": 400, "y": 180 }, "args": [-1, 1, -2, 2] },
      { "id": "addP",  "type": "+~",       "pos": { "x": 40,  "y": 280 } },

      { "id": "osc",   "type": "cycle~",   "pos": { "x": 40,  "y": 380 } },

      { "id": "ccSc",  "type": "scale~",   "pos": { "x": 220, "y": 280 }, "args": [0, 1, 200, 4000] },
      { "id": "filt",  "type": "lores~",   "pos": { "x": 40,  "y": 480 } },

      { "id": "vca",   "type": "*~",       "pos": { "x": 40,  "y": 580 }, "args": [0.18] },
      { "id": "out",   "type": "dac~",     "pos": { "x": 40,  "y": 680 } }
    ],
    "cords": [
      { "src": { "node": "ni", "outlet": 0 }, "dst": { "node": "mtof", "inlet": 0 } },
      { "src": { "node": "mtof", "outlet": 0 }, "dst": { "node": "addP", "inlet": 0 } },
      { "src": { "node": "pb", "outlet": 0 }, "dst": { "node": "pbsc", "inlet": 0 } },
      { "src": { "node": "pbsc", "outlet": 0 }, "dst": { "node": "addP", "inlet": 1 } },

      { "src": { "node": "addP", "outlet": 0 }, "dst": { "node": "osc", "inlet": 0 } },

      { "src": { "node": "cc",   "outlet": 0 }, "dst": { "node": "ccSc", "inlet": 0 } },
      { "src": { "node": "osc",  "outlet": 0 }, "dst": { "node": "filt", "inlet": 0 } },
      { "src": { "node": "ccSc", "outlet": 0 }, "dst": { "node": "filt", "inlet": 1 } },

      { "src": { "node": "filt", "outlet": 0 }, "dst": { "node": "vca", "inlet": 0 } },

      { "src": { "node": "vca",  "outlet": 0 }, "dst": { "node": "out", "inlet": 0 } },
      { "src": { "node": "vca",  "outlet": 0 }, "dst": { "node": "out", "inlet": 1 } }
    ]
  }
}
