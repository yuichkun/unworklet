{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  // `.uwk.ts` is sugar — a deliberate TS error until lowered. Excluded from the
  // standalone `tsc` program here; the per-file `// @ts-nocheck` header is what
  // additionally silences the type-aware lint (tsgolint type-checks per file).
  // `.uwklowered.ts` is the transient temp the build path writes while lowering.
  "exclude": ["**/*.uwk.ts", "**/*.uwklowered.ts"]
}
